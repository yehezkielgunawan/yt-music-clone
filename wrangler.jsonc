{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yt-music-clone",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "side-a-library",
      "migrations_dir": "migrations",
    },
  ],
  "secrets": {
    "required": [
      "AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "ALLOWED_GOOGLE_EMAIL",
      "AUTH_URL",
    ],
  },
  "routes": [
    {
      "pattern": "music.yehezgun.com",
      "custom_domain": true,
    },
  ],
}
